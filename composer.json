{
  "name": "abdulsalam/laravel-idempotency",
  "description": "Production-grade idempotency runtime for Laravel HTTP requests and critical operations.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "idempotency",
    "payments",
    "api",
    "redis",
    "distributed-locking"
  ],
  "require": {
    "php": "^8.2",
    "illuminate/auth": "^11.0 || ^12.0 || ^13.0",
    "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
    "illuminate/console": "^11.0 || ^12.0 || ^13.0",
    "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
    "illuminate/database": "^11.0 || ^12.0 || ^13.0",
    "illuminate/encryption": "^11.0 || ^12.0 || ^13.0",
    "illuminate/http": "^11.0 || ^12.0 || ^13.0",
    "illuminate/validation": "^11.0 || ^12.0 || ^13.0",
    "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
    "illuminate/support": "^11.0 || ^12.0 || ^13.0",
    "symfony/http-foundation": "^7.0 || ^8.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Abdulsalam\\LaravelIdempotency\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Abdulsalam\\LaravelIdempotency\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Abdulsalam\\LaravelIdempotency\\IdempotencyServiceProvider"
      ],
      "aliases": {
        "Idempotency": "Abdulsalam\\LaravelIdempotency\\Facades\\Idempotency"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite=Unit",
    "test:feature": "phpunit --testsuite=Feature"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Abdul Salam Al-Khatib"
    }
  ]
}
